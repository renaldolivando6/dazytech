# Dockerfile khusus DEVELOPMENT (hot reload).
# Untuk production pakai `Dockerfile` (Next.js standalone).
FROM node:24-alpine

WORKDIR /app

# Dependency di-install di dalam image, bukan dari host,
# supaya binary native-nya (better-sqlite3) cocok dengan Linux/musl.
COPY package*.json ./
RUN npm ci

COPY . .

# Jalan sebagai user `node` (uid 1000 = user WSL), supaya file yang dibuat
# dari dalam container (migrasi drizzle, package-lock, data/) tidak jadi
# milik root di folder project.
# .next dibuat di image supaya anonymous volume-nya ikut milik `node`.
RUN mkdir -p /app/.next /app/data && chown -R node:node /app
USER node

ENV NEXT_TELEMETRY_DISABLED=1
# Polling file watcher: aman untuk bind mount dari Windows maupun WSL.
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

EXPOSE 3000

CMD ["npm", "run", "dev:docker"]
